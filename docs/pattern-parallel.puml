@startuml pattern-parallel
!include pattern-theme.puml

title 2. Parallel Workflow\n<size:14>Independent specialists run concurrently, then their results are combined</size>

left to right direction

rectangle "Request\n<size:11>mood</size>" as input #E2E8F0
rectangle "Fan-out\n<size:11>parallel start</size>" as start #FEF3C7
rectangle "FoodExpert\n<size:11>suggests meals</size>" as food #DBEAFE
rectangle "MovieExpert\n<size:11>recommends films</size>" as movie #DBEAFE
rectangle "Combiner\n<size:11>pairs results</size>" as combiner #FEF3C7
rectangle "Evening Plans" as output #DCFCE7

input --> start : mood
start --> food : mood
start --> movie : mood
food --> combiner : meals
movie --> combiner : movies
combiner --> output

@enduml

@startuml pattern-humaninloop
!include pattern-theme.puml
skinparam linetype polyline

title 7. Human-in-the-Loop\n<size:14>The workflow pauses only when the zodiac sign cannot be inferred</size>

left to right direction

rectangle "Horoscope Request" as input #E2E8F0
rectangle "ZodiacExtractor\n<size:11>find sign or UNKNOWN</size>" as extractor #F3E8FF
rectangle "Decision\n<size:11>sign known?</size>" as gate #FEF3C7
rectangle "Human\n<size:11>supplies zodiac sign</size>" as human #E9D5FF
rectangle "HoroscopeAgent\n<size:11>generates reading</size>" as horoscope #F3E8FF
rectangle "Personalized Horoscope" as output #DCFCE7

input --> extractor
extractor --> gate
gate --> horoscope : sign found
gate -down-> human : UNKNOWN
human -right-> horoscope : supplied sign
horoscope --> output

@enduml
@enduml

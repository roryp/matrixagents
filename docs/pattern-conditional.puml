@startuml pattern-conditional
!include pattern-theme.puml

title 5. Conditional Routing\n<size:14>The router selects exactly one specialist at runtime</size>

left to right direction

rectangle "User Request" as input #E2E8F0
rectangle "CategoryRouter\n<size:11>classifies request</size>" as router #DBEAFE
rectangle "MedicalExpert" as medical #DBEAFE
rectangle "LegalExpert" as legal #DBEAFE
rectangle "TechnicalExpert" as technical #DBEAFE
rectangle "Specialist Response" as output #DCFCE7

input --> router
router --> medical : MEDICAL
router --> legal : LEGAL
router --> technical : TECHNICAL
medical --> output
legal --> output
technical --> output

medical -[hidden]down-> legal
legal -[hidden]down-> technical

@enduml
@enduml

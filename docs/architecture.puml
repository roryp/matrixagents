@startuml architecture
!include pattern-theme.puml
skinparam componentStyle rectangle

title Azure Deployment Architecture\n<size:14>Quarkus application packaged with the React frontend in one container</size>

top to bottom direction

package "Azure Resource Group" #EFF6FF {
    rectangle "Azure Container Registry\n<size:11>application image</size>" as acr #DBEAFE
    rectangle "Azure Container Apps\n<size:11>Quarkus 3.30 + Java 21 + React</size>" as app #DCFCE7
    rectangle "Azure OpenAI\n<size:11>gpt-5-mini + text-embedding-3-small</size>" as openai #FFEDD5
    rectangle "Azure Monitor\n<size:11>Application Insights + Log Analytics</size>" as monitor #F3E8FF

    acr --> app : deploy image
    app --> openai : model API calls
    app --> monitor : telemetry

    openai -[hidden]right-> monitor
}

@enduml

@startuml pattern-loop
!include pattern-theme.puml
skinparam linetype polyline

title 4. Loop Workflow\n<size:14>Score and refine until quality reaches 0.8 or five iterations complete</size>

left to right direction

rectangle "Request\n<size:11>topic + style</size>" as input #E2E8F0
rectangle "CreativeWriter\n<size:11>creates initial story</size>" as writer #DBEAFE
rectangle "StyleScorer\n<size:11>returns score</size>" as scorer #DBEAFE
rectangle "Decision\n<size:11>score >= 0.8?</size>" as gate #FEF3C7
rectangle "StyleEditor\n<size:11>refines story</size>" as editor #DBEAFE
rectangle "Final Story" as output #DCFCE7

input --> writer
writer --> scorer : story
scorer --> gate : score
gate --> output : yes
gate -up-> editor : no - refine
editor -left-> scorer : revised story

note top of editor
	Repeat at most 5 times
end note

@enduml
@enduml

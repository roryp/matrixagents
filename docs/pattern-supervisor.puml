@startuml pattern-supervisor
!include pattern-theme.puml
skinparam linetype polyline

title 6. Supervisor Agent\n<size:14>An LLM plans the work, delegates tasks, and synthesizes the response</size>

left to right direction

rectangle "Banking Request" as input #E2E8F0
rectangle "BankSupervisor\n<size:11>plan + orchestrate</size>" as supervisor #F3E8FF
rectangle "WithdrawAgent" as withdraw #EDE9FE
rectangle "CreditAgent" as credit #EDE9FE
rectangle "ExchangeAgent" as exchange #EDE9FE
rectangle "Completed Request" as output #DCFCE7

input --> supervisor
supervisor <--> withdraw : task / result
supervisor <--> credit : task / result
supervisor <--> exchange : task / result
supervisor --> output : synthesize

withdraw -[hidden]down-> credit
credit -[hidden]down-> exchange

@enduml
@enduml

@startuml pattern-p2p
!include pattern-theme.puml
skinparam linetype polyline

title 9. Peer-to-Peer (P2P)\n<size:14>Peers react to shared-state changes until hypothesis quality reaches 0.75</size>

left to right direction

rectangle "Research Topic" as input #E2E8F0
rectangle "LiteratureAgent\n<size:11>research findings</size>" as literature #FFEDD5
rectangle "HypothesisAgent\n<size:11>formulate hypothesis</size>" as hypothesis #FFEDD5
rectangle "CriticAgent\n<size:11>identify weaknesses</size>" as critic #FED7AA
rectangle "ValidationAgent\n<size:11>validate or reformulate</size>" as validation #FED7AA
rectangle "ScorerAgent\n<size:11>quality score</size>" as scorer #FFEDD5
rectangle "Decision\n<size:11>score >= 0.75?</size>" as gate #FEF3C7
rectangle "Validated Hypothesis" as output #DCFCE7

input --> literature
literature --> hypothesis
hypothesis --> critic
critic --> validation
validation ..> hypothesis : reformulate
hypothesis --> scorer
scorer --> gate
gate --> output : score >= 0.75
gate ..> hypothesis : continue refining

@enduml
@enduml

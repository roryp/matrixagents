@startuml patterns-overview
!include pattern-theme.puml

title LangChain4j Agentic Patterns\n<size:14>11 orchestration patterns grouped by who controls execution</size>

top to bottom direction

package "WORKFLOW PATTERNS\n<size:12>Application code defines the path</size>" #EFF6FF {
    rectangle "1. Sequential\n<size:11>fixed chain</size>" as wf1 #DBEAFE
    rectangle "2. Parallel\n<size:11>fan-out / fan-in</size>" as wf2 #DBEAFE
    rectangle "3. Parallel Mapper\n<size:11>one worker per item</size>" as wf3 #DBEAFE
    rectangle "4. Loop\n<size:11>refine to threshold</size>" as wf4 #DBEAFE
    rectangle "5. Conditional\n<size:11>runtime branch</size>" as wf5 #DBEAFE

    wf1 -[hidden]right-> wf2
    wf2 -[hidden]right-> wf3
    wf3 -[hidden]right-> wf4
    wf4 -[hidden]right-> wf5
}

package "AGENTIC PATTERNS\n<size:12>LLM or human judgment controls the path</size>" #FAF5FF {
    rectangle "6. Supervisor\n<size:11>LLM plans + delegates</size>" as ag1 #F3E8FF
    rectangle "7. Human-in-the-Loop\n<size:11>human decision gate</size>" as ag2 #F3E8FF

    ag1 -[hidden]right-> ag2
}

package "PLANNING PATTERNS\n<size:12>Specialized planners coordinate execution</size>" #FFF7ED {
    rectangle "8. GOAP\n<size:11>dependency graph</size>" as pl1 #FFEDD5
    rectangle "9. P2P\n<size:11>reactive peers</size>" as pl2 #FFEDD5
    rectangle "10. Debate\n<size:11>adversarial rounds</size>" as pl3 #FFEDD5
    rectangle "11. Voting\n<size:11>ensemble majority</size>" as pl4 #FFEDD5

    pl1 -[hidden]right-> pl2
    pl2 -[hidden]right-> pl3
    pl3 -[hidden]right-> pl4
}

wf3 -[hidden]down-> ag1
ag1 -[hidden]down-> pl2

@enduml

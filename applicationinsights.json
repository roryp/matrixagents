{
  "connectionString": "${APPLICATIONINSIGHTS_CONNECTION_STRING}",
  "role": {
    "name": "matrix-agents-showcase"
  },
  "preview": {
    "captureHttpClientHeaders": {
      "requestHeaders": ["x-ms-client-request-id", "api-key-present"],
      "responseHeaders": ["x-ms-request-id", "x-ratelimit-remaining-requests"]
    },
    "captureHttpServer4xxAsError": false
  },
  "selfDiagnostics": {
    "destination": "console",
    "level": "WARN"
  }
}
